{
  "platformOptions": {
    "Coverlet": {
      "Exclude": "[*.Tests]*,[xunit*]*",
      "ExcludeByAttribute": "GeneratedCode,ExcludeFromCodeCoverage",
      "Format": "cobertura,json,lcov,opencover",
      "SkipAutoProps": true,
      "ExcludeAssembliesWithoutSources": "MissingAll",
      "Threshold": 59,
      "ThresholdType": "line,branch,method",
      "ThresholdStat": "total"

    }
  }
}
