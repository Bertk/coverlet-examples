  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassIssue1334\ClassIssue1334.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="coverlet.mtp.appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
