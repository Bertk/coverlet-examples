<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <XunitV3Version>4.0.1</XunitV3Version>
    <XunitRunnerVisualstudioVersion>4.0.0</XunitRunnerVisualstudioVersion>
    <CoverletVersion>10.1.1-preview.2.g8b7654e2c0</CoverletVersion>
    <MicrosoftNETRuntimeVersion>10.0.12</MicrosoftNETRuntimeVersion>
    <MicrosoftTestingPlatformVersion>2.4.1</MicrosoftTestingPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSecretsManager.Provider" Version="1.3.6" />
    <PackageVersion Include="coverlet.MTP" Version="$(CoverletVersion)" />
    <PackageVersion Include="coverlet.msbuild" Version="$(CoverletVersion)" />
    <PackageVersion Include="coverlet.collector" Version="$(CoverletVersion)" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftNETRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftNETRuntimeVersion)" />
    <!--<PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3" />-->
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest" Version="4.4.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HtmlReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.runner.msbuild" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.runner.visualstudio" Version="$(XunitRunnerVisualstudioVersion)" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="System.Linq.AsyncEnumerable" Version="$(MicrosoftNETRuntimeVersion)" />
  </ItemGroup>
</Project>
